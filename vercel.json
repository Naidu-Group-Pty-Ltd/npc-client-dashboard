{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "frontend": {
            "root": ".",
            "framework": "vite",
            "installCommand": "npm ci --no-audit --no-fund"
        },
        "aml-verification-service": {
            "root": "services/aml-verification-service",
            "runtime": "container",
            "entrypoint": "Dockerfile",
            "routes": [
                {
                    "src": "/api/(.*)",
                    "transforms": [
                        {
                            "type": "request.path",
                            "op": "set",
                            "args": "/$1"
                        }
                    ]
                }
            ]
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "type": "service",
                "service": "aml-verification-service"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}
